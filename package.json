{
  "name": "dsh-workbuddy-connect",
  "displayName": "WorkBuddy",
  "description": "将 WorkBuddy（国际版 / 国内版）的模型接入 DeepSeek Harness — bring WorkBuddy (Global & CN) models into DeepSeek Harness. Adapted for DSH v0.2.2-rc.1.",
  "icon": "./assets/icon.svg",
  "version": "0.2.0",
  "author": "sunzhengnan",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh-0.2.2-rc.1",
    "workbuddy",
    "workbuddy-ai",
    "codebuddy",
    "model-provider"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "assets",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/compat-0.2.2-rc.1.mjs",
    "test:integration": "node test/integration-0.2.2-rc.1.mjs"
  },
  "engines": {
    "dsh": "^0.2.2-rc.1",
    "node": ">=24.9.0"
  },
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.2-rc.1",
    "@earendil-works/pi-ai": "^1.3.0"
  }
}
